# Modèle de configuration — copier en .env.local et remplir. Ne jamais mettre de vraies clés ici.

# --- Supabase (Project Settings > API) — URL sans /rest/v1 ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_...) ou ancienne clé « anon » (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini (https://aistudio.google.com/apikey) — clé gardée côté serveur ---
GEMINI_API_KEY=
# Modèles essayés dans l'ordre (séparés par des virgules) ; on passe au suivant si le quota est atteint.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# --- Recherche Web (optionnel, recommandé) — https://app.tavily.com ---
# La recherche Google intégrée à Gemini n'est pas toujours incluse dans le quota gratuit.
TAVILY_API_KEY=

# --- Ordre des moteurs IA : ollama,gemini (défaut, le plus rapide) ou gemini,ollama ---
LLM_ORDER=ollama,gemini

# --- Ollama ---
# Local : http://localhost:11434 (sans clé) · Ollama Cloud : https://ollama.com (avec clé)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_API_KEY=

# --- Google (Gmail, Agenda, Drive, Tâches) — clients OAuth « Application Web » ---
# Un client OAuth par compte (_1, _2, … jusqu'à _5). HINT = adresse prévue (affichée sur le bouton).
# URI de redirection autorisée sur chaque client : <URL de l'app>/api/google/callback
GOOGLE_CLIENT_ID_1=
GOOGLE_CLIENT_SECRET_1=
GOOGLE_CLIENT_HINT_1=
GOOGLE_CLIENT_ID_2=
GOOGLE_CLIENT_SECRET_2=
GOOGLE_CLIENT_HINT_2=
# --- Meta (Ads, Facebook, Instagram) — app sur developers.facebook.com ---
# Facultatif si tu colles un jeton d'utilisateur système dans Connexions.
META_APP_ID=
META_APP_SECRET=
# ID de configuration « Facebook Login for Business » (définit les permissions demandées)
META_CONFIG_ID=
META_API_VERSION=v26.0

# Chiffre les jetons Google en base. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
